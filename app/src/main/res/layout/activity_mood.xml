<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A28EB4AA">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Заголовок -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Саша, як ваше самопочуття?"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:gravity="center"
                    android:padding="16dp"/>

            </androidx.cardview.widget.CardView>

            <!-- 5 ЕМОДЖІ В ОДИН РЯД -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Оберіть настрій:"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#2196F3"
                        android:layout_marginBottom="12dp"/>

                    <!-- 5 емоджі в 1 ряд -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <!-- Mood 1 -->
                        <LinearLayout
                            android:id="@+id/mood1"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardMood1"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                app:cardCornerRadius="28dp"
                                app:cardElevation="2dp"
                                app:cardBackgroundColor="#FFEBEE">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:text="😢"
                                    android:textSize="32sp"
                                    android:gravity="center"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Погано"
                                android:textSize="10sp"
                                android:textColor="#757575"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Mood 2 -->
                        <LinearLayout
                            android:id="@+id/mood2"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardMood2"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                app:cardCornerRadius="28dp"
                                app:cardElevation="2dp"
                                app:cardBackgroundColor="#FFF3E0">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:text="😕"
                                    android:textSize="32sp"
                                    android:gravity="center"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Так собі"
                                android:textSize="10sp"
                                android:textColor="#757575"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Mood 3 -->
                        <LinearLayout
                            android:id="@+id/mood3"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardMood3"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                app:cardCornerRadius="28dp"
                                app:cardElevation="2dp"
                                app:cardBackgroundColor="#FFF9C4">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:text="😐"
                                    android:textSize="32sp"
                                    android:gravity="center"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Нормально"
                                android:textSize="10sp"
                                android:textColor="#757575"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Mood 4 -->
                        <LinearLayout
                            android:id="@+id/mood4"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardMood4"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                app:cardCornerRadius="28dp"
                                app:cardElevation="2dp"
                                app:cardBackgroundColor="#E8F5E9">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:text="🙂"
                                    android:textSize="32sp"
                                    android:gravity="center"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Добре"
                                android:textSize="10sp"
                                android:textColor="#757575"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Mood 5 -->
                        <LinearLayout
                            android:id="@+id/mood5"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardMood5"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                app:cardCornerRadius="28dp"
                                app:cardElevation="2dp"
                                app:cardBackgroundColor="#E1F5FE">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:text="😄"
                                    android:textSize="32sp"
                                    android:gravity="center"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Чудово"
                                android:textSize="10sp"
                                android:textColor="#757575"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Обраний настрій -->
                    <TextView
                        android:id="@+id/tvSelectedMood"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="- - -"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#2196F3"
                        android:gravity="center"
                        android:layout_marginTop="12dp"
                        android:padding="8dp"
                        android:backgroundTint="#E3F2FD"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ТЕГИ 3x3 (що відчуваєте) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Що відчуваєте?"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#2196F3"
                        android:layout_marginBottom="12dp"/>

                    <!-- Ряд 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/tagStress"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:text="Стрес"
                            android:textSize="13sp"
                            android:textColor="#D32F2F"
                            android:checkable="true"
                            app:chipBackgroundColor="#FFEBEE"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/tagTired"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:text="Втома"
                            android:textSize="13sp"
                            android:textColor="#F57C00"
                            android:checkable="true"
                            app:chipBackgroundColor="#FFF3E0"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/tagJoy"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:text="Радість"
                            android:textSize="13sp"
                            android:textColor="#388E3C"
                            android:checkable="true"
                            app:chipBackgroundColor="#E8F5E9"/>

                    </LinearLayout>

                    <!-- Ряд 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/tagAnxiety"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:text="Тривога"
                            android:textSize="13sp"
                            android:textColor="#D32F2F"
                            android:checkable="true"
                            app:chipBackgroundColor="#FFCDD2"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/tagEnergy"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:text="Енергія"
                            android:textSize="13sp"
                            android:textColor="#388E3C"
                            android:checkable="true"
                            app:chipBackgroundColor="#C8E6C9"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/tagSad"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:text="Сум"
                            android:textSize="13sp"
                            android:textColor="#1976D2"
                            android:checkable="true"
                            app:chipBackgroundColor="#BBDEFB"/>

                    </LinearLayout>

                    <!-- Ряд 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/tagSick"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:text="Хвороба"
                            android:textSize="13sp"
                            android:textColor="#C62828"
                            android:checkable="true"
                            app:chipBackgroundColor="#FFCDD2"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/tagCalm"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:text="Спокій"
                            android:textSize="13sp"
                            android:textColor="#0288D1"
                            android:checkable="true"
                            app:chipBackgroundColor="#E1F5FE"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/tagMotivated"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:text="Мотивація"
                            android:textSize="13sp"
                            android:textColor="#388E3C"
                            android:checkable="true"
                            app:chipBackgroundColor="#C8E6C9"/>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ФАКТОРИ 3x3 (що вплинуло) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Що вплинуло?"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#2196F3"
                        android:layout_marginBottom="12dp"/>

                    <!-- Ряд 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/factorWeather"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:text="Погода"
                            android:textSize="13sp"
                            android:textColor="#0288D1"
                            android:checkable="true"
                            app:chipBackgroundColor="#E1F5FE"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/factorWork"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:text="Робота"
                            android:textSize="13sp"
                            android:textColor="#F57C00"
                            android:checkable="true"
                            app:chipBackgroundColor="#FFE0B2"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/factorSocial"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:text="Спілкування"
                            android:textSize="13sp"
                            android:textColor="#388E3C"
                            android:checkable="true"
                            app:chipBackgroundColor="#C8E6C9"/>

                    </LinearLayout>

                    <!-- Ряд 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/factorFood"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:text="Їжа"
                            android:textSize="13sp"
                            android:textColor="#7B1FA2"
                            android:checkable="true"
                            app:chipBackgroundColor="#F3E5F5"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/factorCoffee"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:text="Кофеїн"
                            android:textSize="13sp"
                            android:textColor="#D84315"
                            android:checkable="true"
                            app:chipBackgroundColor="#FFE0B2"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/factorExercise"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:text="Спорт"
                            android:textSize="13sp"
                            android:textColor="#388E3C"
                            android:checkable="true"
                            app:chipBackgroundColor="#A5D6A7"/>

                    </LinearLayout>

                    <!-- Ряд 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/factorMedicine"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:text="Ліки"
                            android:textSize="13sp"
                            android:textColor="#C62828"
                            android:checkable="true"
                            app:chipBackgroundColor="#FFCDD2"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/factorSleep"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:text="Сон"
                            android:textSize="13sp"
                            android:textColor="#5E35B1"
                            android:checkable="true"
                            app:chipBackgroundColor="#E1BEE7"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/factorAlcohol"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:text="Алкоголь"
                            android:textSize="13sp"
                            android:textColor="#C62828"
                            android:checkable="true"
                            app:chipBackgroundColor="#FFCDD2"/>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Нотатка -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Додаткові деталі (опціонально):"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#2196F3"
                        android:layout_marginBottom="8dp"/>

                    <EditText
                        android:id="@+id/etNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Опишіть докладніше..."
                        android:inputType="textMultiLine"
                        android:maxLines="3"
                        android:minLines="3"
                        android:gravity="top|start"
                        android:textSize="14sp"
                        android:padding="12dp"
                        android:background="@android:drawable/edit_text"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Кнопки -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveMood"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="💾 Зберегти"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:enabled="false"
                android:backgroundTint="#2196F3"
                android:layout_marginBottom="12dp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardMoodHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📊 Історія"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212121"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="→"
                        android:textSize="24sp"
                        android:textColor="#2196F3"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemIconTint="@color/primary_blue"
        app:itemTextColor="@color/text_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu"
        app:elevation="8dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>